# ═══════════════════════════════════════════════════════════════════════════
#  Voice Authentication System — environment configuration
#  Copy to `.env` and fill in your values. NEVER commit your real .env.
# ═══════════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=false

# ── Security (REQUIRED in production) ─────────────────────────────────────────
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_use_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Upload / pipeline limits ─────────────────────────────────────────────────
MIN_FILES=5
MAX_FILES=20
MAX_UPLOAD_MB=25

# ── SMTP (optional welcome email) ────────────────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Voice Authentication System
